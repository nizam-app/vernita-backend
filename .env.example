NODE_ENV=development
# Local only — on Railway leave HOST unset (uses 0.0.0.0) or set HOST=0.0.0.0
HOST=0.0.0.0
PORT=5000

# Vercel: add the same variable in Project → Settings → Environment Variables (Production + Preview)
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ambitionDB?retryWrites=true&w=majority
# Atlas → Network Access → allow 0.0.0.0/0 (or Vercel cannot connect)
JWT_SECRET=super_secret_key
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CLIENT_URL=http://localhost:3000

# Railway: set CLIENT_URL to your frontend URL; API URL is https://YOUR-SERVICE.up.railway.app
# Stripe webhook: https://YOUR-SERVICE.up.railway.app/api/v1/payments/webhook

# CORS — comma-separated origins for all 3 websites
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Website #2 — consultation form (optional email alerts)
CONSULTATION_DEFAULT_SOURCE=website-2
CONSULTATION_NOTIFY_TO=admin@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Vernita Consultations <your_email@gmail.com>"

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=vernita/uploads
