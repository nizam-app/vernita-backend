NODE_ENV=development
HOST=192.168.10.251
PORT=5000

MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ambitionDB?retryWrites=true&w=majority
JWT_SECRET=super_secret_key
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CLIENT_URL=http://localhost:3000

# CORS — comma-separated origins for all 3 websites
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Website #2 — consultation form (optional email alerts)
CONSULTATION_DEFAULT_SOURCE=website-2
CONSULTATION_NOTIFY_TO=admin@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Vernita Consultations <your_email@gmail.com>"

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=vernita/uploads
